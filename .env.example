# =====================
# 必需环境变量
# =====================

# JWT 密钥（必须至少 32 个字符）
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# 管理员密码（必须至少 8 个字符）
ADMIN_PASSWORD=your-secure-admin-password

# =====================
# AI 密钥（三选一，可全配；配几家就能用几家，全配则按顺序互为降级）
# =====================
# 支持逗号分隔多个 Key 轮询，例如 key1,key2

# 魔搭 ModelScope（默认首选，支持 JSON 输出格式）
AI_API_KEY=your-modelscope-api-key-here

# 商汤日日新（速度快）
SENSENOVA_API_KEY=your-sensenova-api-key-here

# InferX（deepseek-v4.1-flash-1017-basic，仅文本）
INFERX_API_KEY=your-inferx-api-key-here

# =====================
# 可选环境变量
# =====================

# 运行环境（development / production / test）
NODE_ENV=development

# 服务器端口（默认 3000）
PORT=3000

# CORS 允许的源（生产环境建议设置）
ALLOWED_ORIGIN=http://localhost:3000

# 模型名覆盖（一般不用填，用代码里的默认值）
# AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
# SENSENOVA_MODEL=sensenova-6.8-flash-lite
# INFERX_MODEL=deepseek-v4.1-flash-1017-basic
